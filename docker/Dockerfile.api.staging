FROM python:3.12-slim AS version

RUN apt-get update \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src

COPY .git/ .git/

# Reconstruct omitted tracked paths so Git only reports actual changes as dirty.
RUN git checkout-index --all

COPY core/ core/

RUN git describe --tags --always --dirty > /app-version


FROM python:3.12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl redis-tools \
    && rm -rf /var/lib/apt/lists/*

COPY core/ /app/nurse-scheduling/core/
COPY --from=version /app-version /app/nurse-scheduling/.app-version

WORKDIR /app/nurse-scheduling/core

RUN pip install --no-cache-dir -r requirements.txt

RUN useradd -m -u 1000 user \
    && mkdir -p /reports \
    && chown -R user:user /app/nurse-scheduling /reports

USER user

EXPOSE 8000

CMD ["uvicorn", "nurse_scheduling.serve:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--no-access-log"]
