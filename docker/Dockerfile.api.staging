FROM python:3.12-slim AS version

ARG APP_VERSION

RUN : "${APP_VERSION:?Set APP_VERSION from git describe before building}" \
    && printf '%s\n' "$APP_VERSION" > /app-version


FROM python:3.12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl redis-tools \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -m -u 1000 user \
    && mkdir -p /reports /app/nurse-scheduling \
    && chown user:user /reports /app/nurse-scheduling

COPY --chown=user:user core/ /app/nurse-scheduling/core/
COPY --chown=user:user --from=version /app-version /app/nurse-scheduling/.app-version

WORKDIR /app/nurse-scheduling/core

RUN pip install --no-cache-dir -r requirements.txt

USER user

EXPOSE 8000

CMD ["uvicorn", "nurse_scheduling.serve:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--no-access-log"]
