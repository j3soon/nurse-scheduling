# Ref: https://docs.nvidia.com/cuopt/user-guide/latest/cuopt-server/quick-start.html#container-from-docker-hub
# Ref: https://hub.docker.com/r/nvidia/cuopt/tags
FROM nvidia/cuopt:26.8.0a-cuda13.3-py3.14

ARG DEBIAN_FRONTEND=noninteractive

WORKDIR /app

# Common Tools
RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    gnupg \
    iputils-ping \
    jq \
    redis-server \
    redis-tools \
    ripgrep \
    software-properties-common \
    unzip \
    vim \
    && rm -rf /var/lib/apt/lists/*
# Git 2.48+ supports relative worktree paths across host and container mounts.
RUN add-apt-repository -y ppa:git-core/ppa \
    && apt-get update \
    && apt-get install -y --no-install-recommends git \
    && dpkg --compare-versions "$(git --version | cut -d' ' -f3)" ge 2.48 \
    && rm -rf /var/lib/apt/lists/*
RUN git config --system --add safe.directory /app \
    && git config --system --add safe.directory '/app/.worktrees/*'

# Install GitHub CLI from its official apt repository.
RUN mkdir -p -m 755 /etc/apt/keyrings \
    && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
        -o /etc/apt/keyrings/githubcli-archive-keyring.gpg \
    && chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
        > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends gh \
    && rm -rf /var/lib/apt/lists/* \
    && gh --version

# Optional solver support: install the GLPK command-line backend for PuLP.
RUN apt-get update && apt-get install -y --no-install-recommends \
    glpk-utils \
    && rm -rf /var/lib/apt/lists/*

# Install uv and the locked core packages into the active /opt/venv. The venv
# also reads the cuOpt packages that the base image installs system-wide. After
# a dependency change, `uv sync --active --locked --all-extras` in core/ updates it.
COPY --from=ghcr.io/astral-sh/uv:0.13.9 /uv /uvx /usr/local/bin/
COPY core/pyproject.toml core/uv.lock /tmp/core/
ENV VIRTUAL_ENV=/opt/venv \
    PATH="/opt/venv/bin:${PATH}"
# The BuildKit uv cache keeps downloads across lock changes. It sits on another
# file system, so uv copies files instead of hard-linking them.
RUN --mount=type=cache,id=dev-uv,target=/root/.cache/uv,sharing=locked \
    uv venv --system-site-packages --python "$(command -v python)" /opt/venv \
    && uv sync --active --project /tmp/core --locked --all-extras --link-mode copy

# Install Bun
RUN curl -fsSL https://bun.sh/install | bash
ENV PATH="/root/.bun/bin:${PATH}"

# Install the frontend's locked Playwright version and bake browser binaries into
# a stable image path so they survive `docker run --rm` sessions.
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
COPY web-frontend/package.json web-frontend/bun.lock /tmp/web-frontend/
WORKDIR /tmp/web-frontend
RUN bun install --frozen-lockfile
RUN bunx playwright install --with-deps chromium
# Chromium on the Ubuntu CI runner renders system-ui and sans-serif text with
# DejaVu Sans. Install it so local E2E text wrapping matches CI.
RUN apt-get update && apt-get install -y --no-install-recommends fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

# Ref: https://github.com/j3soon/dockerfile-fragments/blob/main/codex/Dockerfile
# Install Codex CLI
RUN curl -fsSL https://deb.nodesource.com/setup_24.x | bash -
RUN apt-get update && apt-get install -y \
    nodejs \
    && rm -rf /var/lib/apt/lists/*
# This remote metadata changes when the npm latest tag advances, which
# invalidates the install layer during normal Docker builds.
ADD https://registry.npmjs.org/@openai%2Fcodex/latest /tmp/openai-codex-latest.json
RUN npm install -g @openai/codex
RUN codex_version="$(codex --version)" \
    && test -n "$codex_version" \
    && echo "Installed Codex CLI: $codex_version"

# Ref: https://github.com/j3soon/dockerfile-fragments/blob/main/claude-code/Dockerfile
# Install Claude Code CLI
ENV IS_SANDBOX=1
# This remote version marker changes when the Claude Code latest release
# advances, which invalidates the install layer during normal Docker builds.
ADD https://downloads.claude.ai/claude-code-releases/latest /tmp/claude-code-latest-version
ENV PATH="/root/.local/bin:${PATH}"
RUN curl -fsSL https://claude.ai/install.sh | bash
RUN claude_version="$(claude --version)" \
    && test -n "$claude_version" \
    && echo "Installed Claude Code CLI: $claude_version"
# The co/cl/op/ag yolo aliases only exist inside the container, so yolo stays
# a short, deliberate launch here instead of a habit that could accidentally
# run on the host machine, similar to the two-character pi shortcut.
RUN echo 'alias claude-yolo="claude --allow-dangerously-skip-permissions --dangerously-skip-permissions"' >> /root/.bashrc \
    && echo 'alias cl="claude-yolo"' >> /root/.bashrc \
    && echo 'alias co="codex --yolo"' >> /root/.bashrc \
    && echo 'alias op="opencode --yolo"' >> /root/.bashrc \
    && echo 'alias ag="agy --dangerously-skip-permissions"' >> /root/.bashrc

# Ref: https://github.com/j3soon/dockerfile-fragments/blob/main/opencode/Dockerfile
# Install OpenCode CLI
# This remote metadata changes when the npm latest tag advances, which
# invalidates the install layer during normal Docker builds.
ADD https://registry.npmjs.org/opencode-ai/latest /tmp/opencode-latest.json
ENV PATH="/root/.opencode/bin:${PATH}"
RUN npm install -g opencode-ai@latest
RUN opencode_version="$(opencode --version)" \
    && test -n "$opencode_version" \
    && echo "Installed OpenCode CLI: $opencode_version"

# Ref: https://github.com/j3soon/dockerfile-fragments/blob/main/pi/Dockerfile
# Install Pi Coding Agent
# This remote metadata changes when the npm latest tag advances, which
# invalidates the install layer during normal Docker builds.
ADD https://registry.npmjs.org/@earendil-works%2Fpi-coding-agent/latest /tmp/pi-coding-agent-latest.json
RUN npm install -g --ignore-scripts @earendil-works/pi-coding-agent
RUN pi_version="$(pi --version)" \
    && test -n "$pi_version" \
    && echo "Installed Pi Coding Agent: $pi_version"
RUN mkdir -p /root/.pi/agent

# Ref: https://github.com/j3soon/dockerfile-fragments/blob/main/antigravity-cli/Dockerfile
# Install Antigravity CLI
# This remote release manifest changes when the Antigravity CLI latest release
# advances, which invalidates the install layer during normal Docker builds.
ADD https://antigravity-cli-auto-updater-974169037036.us-central1.run.app/manifests/linux_amd64.json /tmp/antigravity-cli-latest.json
RUN curl -fsSL https://antigravity.google/cli/install.sh | bash
RUN agy_version="$(agy --version)" \
    && test -n "$agy_version" \
    && echo "Installed Antigravity CLI: $agy_version"

WORKDIR /app

ENTRYPOINT ["/bin/bash"]
