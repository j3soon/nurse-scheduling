CLOUDFLARE_TUNNEL_TOKEN=
# Shared token for the backend API. Generate one with `openssl rand -base64 32`.
# The deployment image sets API_AUTH_REQUIRED=true, so leaving this empty stops the server
# from starting. Serving with no authentication requires API_AUTH_REQUIRED=false.
API_AUTH_TOKEN=
API_AUTH_REQUIRED=true
# Set to 1 to disable Sentry for every Python service.
DISABLE_SENTRY=
# Public DSN for the Python backend's Sentry project.
SENTRY_BACKEND_DSN=
SENTRY_ENVIRONMENT=production
DIAGNOSTIC_TARGET_URL=https://api.nursescheduling.org
OPTIMIZE_SOLVERS=ortools/cp-sat,pulp/cuopt
OPTIMIZE_DEFAULT_SOLVER=pulp/cuopt
OPTIMIZE_MIN_TIMEOUT_SECONDS=1
OPTIMIZE_DEFAULT_TIMEOUT_SECONDS=300
OPTIMIZE_MAX_TIMEOUT_SECONDS=3600
OPTIMIZE_DEFAULT_PRETTIFY=true
# Set all three from a complete compute benchmark or leave all three empty.
CLAIMED_PERFORMANCE_SCORE=
CLAIMED_PERFORMANCE_APP_VERSION=
CLAIMED_PERFORMANCE_MEASURED_AT=
