from __future__ import annotations

import argparse
from pathlib import Path

DEFAULT_SCHEMA_FILE = Path("/reference/schedule-schema.md")
SECTION_SEPARATOR = "\n\n---\n\n"


def _sections(schema_file: Path) -> list[str]:
    try:
        content = schema_file.read_text(encoding="utf-8")
    except OSError as error:
        raise SystemExit(f"nsctl: cannot read schema reference: {error}") from error
    return content.split(SECTION_SEPARATOR)


def _path(section: str) -> str | None:
    first_line = section.splitlines()[0] if section else ""
    return first_line.removeprefix("Path: ") if first_line.startswith("Path: ") else None


def _schema(args: argparse.Namespace) -> None:
    sections = _sections(args.schema_file)
    if args.schema_command is None:
        print(sections[0])
        return

    topics = {path: section for section in sections if (path := _path(section)) is not None}
    if args.schema_command == "list":
        print("\n".join(topics))
        return
    if args.schema_command == "show":
        section = topics.get(args.path)
        if section is None:
            matches = [path for path in topics if args.path.casefold() in path.casefold()]
            hint = f" Closest path matches: {', '.join(matches[:5])}." if matches else ""
            raise SystemExit(f"nsctl: unknown schema path: {args.path}.{hint}")
        print(section)
        return

    query = args.query.casefold()
    matches = [path for path, section in topics.items() if query in section.casefold()]
    if not matches:
        raise SystemExit(f"nsctl: no schema topics match: {args.query}")
    print("\n".join(matches))


def _parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="nsctl", description="Inspect Nurse Scheduling sandbox references.")
    parser.add_argument(
        "--schema-file",
        type=Path,
        default=DEFAULT_SCHEMA_FILE,
        help=argparse.SUPPRESS,
    )
    commands = parser.add_subparsers(dest="command", required=True)
    schema = commands.add_parser("schema", help="inspect the frontend-editable schedule schema")
    schema.set_defaults(handler=_schema)
    schema_commands = schema.add_subparsers(dest="schema_command")
    schema_commands.add_parser("list", help="list available schema paths")
    show = schema_commands.add_parser("show", help="show one exact schema path")
    show.add_argument("path")
    search = schema_commands.add_parser("search", help="find schema paths whose guidance contains text")
    search.add_argument("query")
    return parser


def main() -> None:
    args = _parser().parse_args()
    args.handler(args)


if __name__ == "__main__":
    main()
