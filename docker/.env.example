# General
CLOUDFLARE_TUNNEL_TOKEN=
# Set to 1 to disable Sentry for every Python service.
DISABLE_SENTRY=
# Public DSN for the Python backend's Sentry project.
SENTRY_BACKEND_DSN=
SENTRY_ENVIRONMENT=production

# Backend
# Shared token for the backend API. Generate one with `openssl rand -base64 32`.
# The deployment image sets API_AUTH_REQUIRED=true, so leaving this empty stops the server
# from starting. Serving with no authentication requires API_AUTH_REQUIRED=false.
API_AUTH_TOKEN=
API_AUTH_REQUIRED=true
OPTIMIZE_SOLVERS=ortools/cp-sat
OPTIMIZE_DEFAULT_SOLVER=ortools/cp-sat
OPTIMIZE_MIN_TIMEOUT_SECONDS=1
OPTIMIZE_DEFAULT_TIMEOUT_SECONDS=300
OPTIMIZE_MAX_TIMEOUT_SECONDS=3600
OPTIMIZE_DEFAULT_PRETTIFY=true
# Set all three from a complete compute benchmark or leave all three empty.
CLAIMED_PERFORMANCE_SCORE=
CLAIMED_PERFORMANCE_APP_VERSION=
CLAIMED_PERFORMANCE_MEASURED_AT=
USAGE_METRICS_ENABLED=true
USAGE_METRICS_RETENTION_DAYS=30

# Reporter
USAGE_REPORT_LOCAL_HOUR=0
USAGE_REPORT_SUBJECT="Nurse Scheduling backend usage: {week_id}"
USAGE_REPORT_TRANSPORT=stdout
MAILGUN_API_KEY=
MAILGUN_API_URL=
MAILGUN_DOMAIN=
MAILGUN_FROM=
MAILGUN_TO=

# Diagnostic
DIAGNOSTIC_TARGET_URL=

# AI assistant
# The Compose service requires this token by default. Generate one with `openssl rand -base64 32`.
# Serving without authentication requires AI_AUTH_REQUIRED=false and an empty token.
AI_AUTH_TOKEN=
AI_AUTH_REQUIRED=true
AI_PROVIDER_BASE_URL=
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=local-model
AI_PROVIDER_TIMEOUT_SECONDS=120
AI_PROVIDER_MAX_ATTEMPTS=3
AI_PROVIDER_RETRY_BACKOFF_SECONDS=1
E2B_API_KEY=
AI_SANDBOX_BACKEND=e2b
E2B_TEMPLATE=nurse-scheduling-ai-sandbox
AI_SANDBOX_COMMAND_TIMEOUT_SECONDS=10
AI_SANDBOX_TURN_TIMEOUT_SECONDS=900
AI_SANDBOX_CLEANUP_TIMEOUT_SECONDS=10
AI_SANDBOX_MAX_ATTEMPTS=3
AI_SANDBOX_RETRY_BACKOFF_SECONDS=0.5
AI_SANDBOX_PAUSE_REQUEST_TIMEOUT_SECONDS=5
AI_SANDBOX_CONTROL_REQUEST_TIMEOUT_SECONDS=2
AI_SANDBOX_REAPER_INTERVAL_SECONDS=30
AI_BACKEND_PORT=8001
AI_COOKIE_SECURE=1
AI_ATTACHMENT_MODE=images
AI_MAX_IMAGE_FILES=4
AI_MAX_IMAGE_BYTES=5000000
AI_DOCUMENT_ATTACHMENT_MODE=text
AI_MAX_DOCUMENT_FILES=4
AI_MAX_DOCUMENT_BYTES=5000000
AI_MAX_DOCUMENT_TEXT_CHARS=50000
AI_MAX_PDF_PAGES=100
AI_MAX_XLSX_SHEETS=20
AI_MAX_XLSX_CELLS=100000
AI_MAX_XLSX_UNCOMPRESSED_BYTES=50000000
