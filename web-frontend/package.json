{
  "name": "web-frontend",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --turbopack",
    "dev:e2e": "NEXT_TELEMETRY_DISABLED=1 next dev --webpack --hostname 127.0.0.1 --port 3000",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start",
    "build:e2e": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start:e2e": "bunx serve@latest out -l 3000",
    "lint": "eslint .",
    "test": "vitest run",
    "test:affected": "../scripts/test_frontend_affected.sh",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "docs:screenshots": "playwright test -c playwright.docs.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:affected": "../scripts/test_frontend_e2e_affected.sh",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:coverage": "rm -rf .e2e-coverage coverage-e2e && E2E_COVERAGE=1 playwright test --reporter=dot --quiet --max-failures=1",
    "coverage:e2e:report": "node scripts/generate-e2e-coverage.mjs"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.78.0",
    "js-yaml": "^4.3.2",
    "jszip": "^3.10.2",
    "next": "16.4.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-icons": "^5.7.0",
    "react-is": "^19.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.11.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.9.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "exceljs": "^4.4.0",
    "jsdom": "^29.1.1",
    "monocart-coverage-reports": "^2.13.2",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@sentry/bundler-plugins": {
      "glob": "^14.0.6"
    },
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
