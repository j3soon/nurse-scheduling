    },
    {
      "path": "preferences[?type=shift affinity].people2",
      "contains": "Person 8"
    },
    {
      "path": "preferences[?type=shift affinity].people1",
      "count": 1
    },
    {
      "path": "preferences[?type=shift affinity].people2",
      "count": 1
    },
    {
      "path": "preferences[?type=shift affinity].shiftTypes",
      "count": 1
    },
    {
      "path": "preferences",
      "delta": 1
    }
  ],
  "changes": [
    "preferences"
  ]
}
