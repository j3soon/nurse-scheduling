{
  "id": "pref-count-coefficients",
  "fixture": "new-schedule",
  "question": "Person 6 should reach 6 workload points over the roster, counting D as 1 and N as 2.",
  "expect_proposal": true,
  "assert": [
    {
      "path": "preferences[?type=shift count][?person=Person 6].countShiftTypeCoefficients",
      "equals": [
        [
          "D",
          1
        ],
        [
          "N",
          2
        ]
      ]
    },
    {
      "path": "preferences[?type=shift count][?person=Person 6].target",
      "equals": 6
    },
    {
      "path": "preferences[?type=shift count][?person=Person 6].person",
      "equals": [
        "Person 6"
      ]
    },
    {
      "path": "preferences",
      "delta": 1
    }
  ],
  "changes": [
    "preferences"
  ]
}
