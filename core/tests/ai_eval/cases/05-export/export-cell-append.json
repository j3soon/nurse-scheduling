{
  "id": "export-cell-append",
  "fixture": "new-schedule",
  "question": "In the export, append the text * to Person 3's D shift cells and add the note 'Requested'.",
  "expect_proposal": true,
  "assert": [
    {
      "path": "export.formatting[?type=cell].people",
      "equals": [
        "Person 3"
      ]
    },
    {
      "path": "export.formatting[?type=cell].shiftTypes",
      "equals": [
        "D"
      ]
    },
    {
      "path": "export.formatting[?type=cell].appendText",
      "equals": "*"
    },
    {
      "path": "export.formatting[?type=cell].note.text",
      "equals": "Requested"
    },
    {
      "path": "export.formatting",
      "count": 1
    }
  ],
  "changes": [
    "export"
  ],
  "note": "The appended text is given exactly, since a star could otherwise be any of several characters."
}
