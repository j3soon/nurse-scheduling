      "equals": "Float nurse"
    },
    {
      "path": "people.items[].id",
      "added": []
    },
    {
      "path": "people.items[].id",
      "removed": []
    }
  ],
  "changes": [
    "people.items"
  ],
  "tool_usage": {
    "required": [
      "edit"
    ],
    "forbidden": [
      "write"
    ],
    "max_total": 4,
    "max_per_tool": {
      "edit": 1
    }
  }
}
